{
  "name": "OcaTech-MakeVideo",
  "version": "1.0.0",
  "description": "A screen recorder for creating video tutorials",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder --win"
  },
  "author": "Oluegwu Chigozie",
  "license": "MIT",
  "dependencies": {
    "electron-log": "^5.0.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "uiohook-napi": "^1.5.4"
  },
  "build": {
    "appId": "com.ocatech.makevideo",
    "productName": "OcaTech-MakeVideo",
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "appIcon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "OcaTech MakeVideo"
    },
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      },
      {
        "from": "appIcon.png",
        "to": "appIcon.png"
      }
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "asar": true
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1"
  }
}
