{
  "name": "OcaTech-MakeVideo",
  "version": "1.0.0",
  "description": "A screen recorder for creating video tutorials",
  "main": "src/main/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-packager . OcaTech-MakeVideo --extra-resource=node_modules/ffmpeg-static/ffmpeg.exe --extra-resource=frontend/images/appIcon.png --icon=appIcon.ico --asar --overwrite",
    "build:win": "electron-builder --win"
  },
  "author": "Oluegwu Chigozie",
  "license": "MIT",
  "devDependencies": {
    "electron": "^25.1.1",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.1"
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3"
  }
}